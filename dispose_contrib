#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="${0##*/}"

log() {
  printf '==> %s\n' "$*" >&2
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<EOF
Usage: $SCRIPT_NAME --m=<name> [options]

  e.g.: $SCRIPT_NAME --m=my_module
        $SCRIPT_NAME --m=my_module --dir=~/your/project/dir

Permanently deletes the DDEV project and the module directory for <name>,
everything setup_contrib created for it. Asks for confirmation first. This
cannot be undone.

Required:
  --m=<name>    Drupal contrib module machine name, the same one passed to
                setup_contrib's --mn.

Optional:
  --dir=<path>  Directory the module is in, if you ran setup_contrib with
                --dir. Defaults to the directory this script is sitting in.
                Must already exist. Supports a leading ~.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found on PATH."
}

main() {
  local module=""
  local target_dir=""
  local contribs_dir module_dir confirmation

  for arg in "$@"; do
    case "$arg" in
      --m=*) module="${arg#--m=}" ;;
      --dir=*) target_dir="${arg#--dir=}" ;;
      -h|--help) usage; exit 0 ;;
      *) log "unrecognized argument '$arg'"; usage; exit 2 ;;
    esac
  done

  [[ -n "$module" ]] || { log "--m is required"; usage; exit 2; }
  [[ "$module" =~ ^[a-z][a-z0-9_]*$ ]] \
    || die "--m '$module' doesn't look like a Drupal machine name (lowercase letters, digits, underscores, starting with a letter)."

  if [[ -n "$target_dir" ]]; then
    # A leading ~ in --dir=~/path isn't expanded by the shell (it's not at
    # the start of the whole word), so expand it ourselves.
    case "$target_dir" in
      "~") target_dir="$HOME" ;;
      "~/"*) target_dir="$HOME/${target_dir#"~/"}" ;;
    esac
    [[ -d "$target_dir" ]] || die "$target_dir does not exist."
    target_dir="$(cd "$target_dir" && pwd)"
  fi

  if [[ -n "$target_dir" ]]; then
    contribs_dir="$target_dir"
  else
    contribs_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  fi
  module_dir="$contribs_dir/$module"

  log "This will permanently delete:"
  if [[ -d "$module_dir/.ddev" ]]; then
    log "  - the DDEV project in $module_dir (containers, database, DDEV config)"
  fi
  log "  - $module_dir"

  read -r -p "Type '$module' to confirm: " confirmation
  [[ "$confirmation" == "$module" ]] || die "confirmation did not match, aborting."

  if [[ -d "$module_dir/.ddev" ]]; then
    # cd into module_dir so ddev acts on the project defined by its own
    # .ddev/config.yaml, never a name lookup that could match an unrelated
    # project elsewhere on the machine with the same name.
    require_cmd ddev
    log "[$module] deleting DDEV project"
    (cd "$module_dir" && ddev delete --omit-snapshot -y) \
      || log "[$module] ddev delete failed, continuing to remove files anyway"
  fi

  if [[ -d "$module_dir" ]]; then
    log "[$module] removing $module_dir"
    rm -rf "$module_dir"
  else
    log "[$module] $module_dir does not exist, nothing to remove"
  fi

  log "[$module] done"
}

main "$@"
